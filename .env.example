# Copy to .env. Everything works without changes; secrets stay empty in git.
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://alerting:alerting@localhost:5432/alerting
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:19092
SMTP_HOST=localhost
SMTP_PORT=1025
# Required when NODE_ENV=production: openssl rand -hex 32 (dev uses a built-in default)
JWT_SECRET=
PUBLIC_URL=http://localhost:5173
INGEST_PUBLIC_URL=http://localhost:3001
FILE_SOURCE_ROOT=/var/log
EVENT_STREAM_SHARDS=1
API_PUBLIC_URL=http://localhost:3000
PROMETHEUS_URL=http://localhost:9090
FEATURE_AI=false
# Optional real channels (mock mode when empty)
TELEGRAM_BOT_TOKEN=
TEAMS_WEBHOOK_URL=

# Connectors (#46): generated collector configs, ingest URL seen by the collector, allowed ports
COLLECTOR_CONFIG_DIR=collector/generated
COLLECTOR_INGEST_URL=http://localhost:3001
COLLECTOR_PORTS=5514-5530
